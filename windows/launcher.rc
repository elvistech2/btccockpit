#include <windows.h>

/* Os numeros de versao aqui sao marcadores: o build.ps1 troca todos pela versao
   do package.json antes de chamar o rc.exe. Nao edite a mao. */

1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,0,0,0
PRODUCTVERSION  0,0,0,0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "BTC Radar"
      VALUE "FileDescription",  "BTC Radar - painel local de mercado do bitcoin"
      VALUE "FileVersion",      "0.0.0.0"
      VALUE "InternalName",     "btc-radar"
      VALUE "LegalCopyright",   "MIT"
      VALUE "OriginalFilename", "BTC Radar.exe"
      VALUE "ProductName",      "BTC Radar"
      VALUE "ProductVersion",   "@VERSAO@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
